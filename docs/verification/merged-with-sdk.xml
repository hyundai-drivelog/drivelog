<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.drivelog.app"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="28"
        android:targetSdkVersion="36" />
    <!-- AAOS application; this feature declaration grants no vehicle API access. -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.screen.portrait"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.screen.landscape"
        android:required="false" />

    <uses-permission android:name="ai.pleos.playground.service.vehicle.VEHICLE_BINDING" />

    <queries>
        <intent>
            <action android:name="ai.pleos.playground.vehicle.VEHICLE_START" />
        </intent>
        <intent>
            <action android:name="ai.pleos.playground.caas.intent.action.SPEECH_START" />
        </intent>

        <package android:name="ai.pleos.playground.service.location.fused" />

        <intent>
            <action android:name="ai.pleos.playground.intent.action.NAVI_START" />
        </intent>
    </queries> <!-- CCG Validation 체크를 위한 권한 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="ai.pleos.playground.service.location.fused.FUSED_LOCATION_BINDING" />

    <permission
        android:name="com.drivelog.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.drivelog.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DRIVELOG" >

        <!-- Parked development screen: no distractionOptimized declaration. -->
        <activity
            android:name="com.drivelog.app.MainActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="ai.pleos.playground.service.vehicle.min_version_name"
            android:value="2.3.13" />
        <meta-data
            android:name="ai.pleos.playground.service.vehicle.min_version_code"
            android:value="65" />
        <meta-data
            android:name="ai.pleos.playground.sdk.vehicle.current_version_name"
            android:value="2.3.2" />
        <meta-data
            android:name="ai.pleos.playground.sdk.vehicle.current_version_code"
            android:value="73" /> <!-- CAAS minimum version: matches the actual GAAS package name (ai.pleos.playground.caas) -->
        <meta-data
            android:name="ai.pleos.playground.caas.min_version_name"
            android:value="4.1.29" />
        <meta-data
            android:name="ai.pleos.playground.caas.min_version_code"
            android:value="4001029" /> <!-- Deprecated: legacy keys kept for backward compatibility with older app-market versions -->
        <meta-data
            android:name="ai.pleos.playground.service.caas.min_version_name"
            android:value="4.1.29" />
        <meta-data
            android:name="ai.pleos.playground.service.caas.min_version_code"
            android:value="4001029" />
        <meta-data
            android:name="ai.pleos.playground.sdk.tts.current_version_name"
            android:value="3.3.1" />
        <meta-data
            android:name="ai.pleos.playground.sdk.tts.current_version_code"
            android:value="3003001" />
        <meta-data
            android:name="ai.pleos.playground.service.location.fused.min_version_name"
            android:value="0.5.0" />
        <meta-data
            android:name="ai.pleos.playground.service.location.fused.min_version_code"
            android:value="1" />
        <meta-data
            android:name="ai.pleos.playground.sdk.location.fused.current_version_name"
            android:value="1.1.3" />
        <meta-data
            android:name="ai.pleos.playground.sdk.location.fused.current_version_code"
            android:value="12" />
        <meta-data
            android:name="ai.pleos.playground.service.navi.helper.min_version_name"
            android:value="2.0.1" />
        <meta-data
            android:name="ai.pleos.playground.service.navi.helper.min_version_code"
            android:value="11" />
        <meta-data
            android:name="ai.pleos.playground.sdk.navi.helper.current_version_name"
            android:value="3.0.5" />
        <meta-data
            android:name="ai.pleos.playground.sdk.navi.helper.current_version_code"
            android:value="75" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.drivelog.app.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>